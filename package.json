{
  "name": "scriptlauncher",
  "private": true,
  "version": "0.9.1",
  "description": "A local Windows launcher for scripts, applications, WSL commands, and URLs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rowanjove/RunTelos.git"
  },
  "homepage": "https://github.com/rowanjove/RunTelos#readme",
  "bugs": "https://github.com/rowanjove/RunTelos/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "check": "npm test && npm run verify:project && npm run build && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml && npm audit && npm run audit:rust",
    "audit:rust": "cargo audit --file src-tauri/Cargo.lock --ignore RUSTSEC-2026-0194 --ignore RUSTSEC-2026-0195",
    "verify:project": "node scripts/verify-project.mjs",
    "build:portable": "powershell -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "verify:release": "powershell -ExecutionPolicy Bypass -File scripts/verify-release-binary.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "lucide-react": "^1.39.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.11"
  }
}
